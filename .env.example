# ==============================================================================
# Zendesk AI Reply Copilot - Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# ------------------------------------------------------------------------------
# AI Provider Options: "mock" (default, zero-cost offline), "ollama", "openai"
# ------------------------------------------------------------------------------
AI_PROVIDER=mock
AI_FALLBACK_PROVIDER=

# OpenAI Settings (required only when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama Settings (required only when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b

# ------------------------------------------------------------------------------
# Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot

# ------------------------------------------------------------------------------
# Security, Authentication & Zendesk Integration
# ------------------------------------------------------------------------------
ZENDESK_SUBDOMAIN=yourcompany
ZENDESK_CLIENT_ID=your_zendesk_client_id
ZENDESK_CLIENT_SECRET=dev_zendesk_secret_min_32_chars_long_placeholder
ADMIN_API_KEY=dev_admin_api_key_min_32_chars_long_placeholder
JWT_SECRET=dev_jwt_secret_min_32_chars_long_placeholder

# Allowed Origins (CORS whitelist, comma-separated)
ALLOWED_ORIGINS=https://static.zdassets.com

# Observability
LOG_LEVEL=info

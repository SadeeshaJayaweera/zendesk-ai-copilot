{
  "name": "zendesk-ai-copilot",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise AI Support Engineering Platform for Zendesk",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "build": "npm --workspace=server run build",
    "test": "npm --workspace=server run test",
    "lint": "npm --workspace=server run lint",
    "start": "npm --workspace=server run start",
    "dev": "npm --workspace=server run dev",
    "db:migrate": "npm --workspace=server run db:migrate"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "typescript": "5.4.5"
  }
}
